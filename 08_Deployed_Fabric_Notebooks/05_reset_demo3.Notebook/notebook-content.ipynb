            "source": [
                "# Reset after rehearsing Demo 3: empties new_evidence so the live reveal starts from 0.\n",
                "spark.sql(\"DELETE FROM new_evidence\")\n",
                "cnt = spark.sql(\"SELECT COUNT(*) AS c FROM new_evidence\").collect()[0][\"c\"]\n",
                "print(\"new_evidence rows after reset:\", cnt)\n",
                "assert cnt == 0\n"
            ],
            "outputs": []
        }
